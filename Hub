loadingText.Parent = bg

-- LOADING BAR BG
local barBG = Instance.new("Frame")
barBG.Size = UDim2.new(0.6,0,0,20)
barBG.Position = UDim2.new(0.2,0,0.52,0)
barBG.BackgroundColor3 = Color3.fromRGB(40,40,40)
barBG.Parent = bg
Instance.new("UICorner", barBG)

-- BAR FILL
local bar = Instance.new("Frame")
bar.Size = UDim2.new(0,0,1,0)
bar.BackgroundColor3 = Color3.fromRGB(0,170,255)
bar.Parent = barBG
Instance.new("UICorner", bar)

-- PERCENT
local percent = Instance.new("TextLabel")
percent.Size = UDim2.new(1,0,0,40)
percent.Position = UDim2.new(0,0,0.58,0)
percent.BackgroundTransparency = 1
percent.Text = "0%"
percent.TextColor3 = Color3.fromRGB(255,255,255)
percent.Font = Enum.Font.GothamBold
percent.TextScaled = true
percent.Parent = bg

-- SPIN LOADER
local spinner = Instance.new("ImageLabel")
spinner.Size = UDim2.new(0,60,0,60)
spinner.Position = UDim2.new(0.5,-30,0.65,0)
spinner.BackgroundTransparency = 1
spinner.Image = "rbxassetid://4965945816" -- default loading circle
spinner.Parent = bg

-- SOUND EFFECT (put your own sound id here)
local sound = Instance.new("Sound")
sound.SoundId = "rbxassetid://9118823101"
sound.Volume = 1
sound.Parent = SoundService
sound:Play()

-- LOADING TEXT ANIMATION
task.spawn(function()
	while task.wait(0.5) do
		loadingText.Text = "Loading"
		task.wait(0.5)
		loadingText.Text = "Loading."
		task.wait(0.5)
		loadingText.Text = "Loading.."
		task.wait(0.5)
		loadingText.Text = "Loading..."
	end
end)

-- SPIN ANIMATION
task.spawn(function()
	while task.wait() do
		spinner.Rotation = spinner.Rotation + 5
	end
end)

-- 5 MIN FILL BAR
local duration = 300
local steps = 100

for i = 1, steps do
	local progress = i / steps

	percent.Text = math.floor(progress * 100) .. "%"

	TweenService:Create(
		bar,
		TweenInfo.new(duration / steps, Enum.EasingStyle.Linear),
		{Size = UDim2.new(progress, 0, 1, 0)}
	):Play()

	task.wait(duration / steps)
end

loadingText.Text = "Loaded!"
task.wait(2)

gui:Destroy()
